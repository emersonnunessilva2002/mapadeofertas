---
import Nav from "../components/nav.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

const {
	title = "Mapa de Promoções",
	description = "As melhores ofertas de eletrônicos aqui",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="description" content={description} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<meta name="robots" content="index, follow" />
		<title>{title}</title>
		<meta
			name="google-site-verification"
			content="7ToxFx0EGpg_Gvx_yVQNcCHsRZ28FEiKbJnR0j_GMC0"
		/>
		<ClientRouter />
		<script
			async
			src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6656979717042353"
			crossorigin="anonymous"></script>
	</head>
	<body>
		<Nav />
		<slot />
		<div class="min-h-[30vh]"></div>
		<Footer />
	</body>
</html>
