---
import Layout from '../../layouts/Layout.astro';
import PostsList from '../../components/posts-list.astro';
import Navbar from '../../components/navbar.astro';
import PostsRecommended from '../../components/posts-recommended.astro';

const posts = import.meta.glob('../../content/posts/*.md', {
  eager: true
});

const postsList = Object.entries(posts)
  .map(([_, post]) => post);
---
<Layout title="Mapa de Ofertas | Ofertas" description="Todas as ofertas de produtos Eletrônicos" >
    <PostsRecommended posts={postsList} />   
</Layout>
