---
import Layout from '../../layouts/Layout.astro';
import PostsRecommended from '../../components/posts-recommended.astro';

const posts = import.meta.glob('../../content/posts/*.md', {
  eager: true
});

const postsList = Object.entries(posts)
  .map(([_, post]) => post);
---
<Layout title="Mapa de Promos | Ofertas" description="Todas as promoções e Ofertas de produtos eletrônicos no Mapa de Promos" >
    <PostsRecommended posts={postsList} />   
</Layout>
