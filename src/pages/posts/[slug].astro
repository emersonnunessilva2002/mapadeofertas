---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Navbar from '../../components/navbar.astro';
import ArrowLeft from '../../assets/arrow-left.svg';
export function getStaticPaths() {
const posts = import.meta.glob('../../content/posts/*.md', {
    eager: true
});

    return Object.entries(posts).map(([path, post]) => {
        const slug = path.split('/').pop().replace('.md', '');

        return {
            params: { slug },
            props: { post }
        };
    });
}

const { post } = Astro.props;
const { slug }= Astro.params;

if (!post) {
    return new Response(null, {
        status: 404
    });
}

const { Content } = post;
---

<Layout title=`Mapa de Ofertas | ${slug}`> 
    <Navbar />
     
    <main class="flex flex-col gap-5 max-w-screen-lg mx-auto mt-10 p-10">   
        <article class="flex flex-col gap-5 mb-4 md:mb-0 w-full mx-auto relative">
           
<ArrowLeft class="w-8 h-8 text-green-700" onclick="history.back()" cursor={'pointer'}/>
   <div class="px-4 lg:px-0">
          <h2 class="text-4xl font-semibold text-gray-800 leading-tight">
            {post.frontmatter.title}
          </h2>
          <a 
            href=`/category/${post.frontmatter.category}`
            class="py-2 text-green-700 inline-flex items-center justify-center mb-2"
          >
            {post.frontmatter.category}
        </a>
        </div>
        <img src={post.frontmatter.image}/>
        </article>
  <Content />
</main>
</Layout>
