---
import Layout from '../../layouts/Layout.astro';
import { ChevronRight } from '@lucide/astro';
export function getStaticPaths() {
const posts = import.meta.glob('../../content/posts/*.md', {
    eager: true
});

    return Object.entries(posts).map(([path, post]) => {
        const slug = path.split('/').pop().replace('.md', '');

        return {
            params: { slug },
            props: { post }
        };
    });
}

const { post } = Astro.props;
const { slug }= Astro.params;

if (!post) {
    return new Response(null, {
        status: 404
    });
}

const { Content } = post;

---

<Layout title="Melhores Tablets 2026: TOP 10 Modelos para Comprar" description={post.frontmatter.description}> 
    <nav class="w-full max-w-[800px] m-auto">
            <ol class="flex flex-wrap items-center justify-center w-full gap-2 text-[1rem] p-8">
              <li>
                        <a href="/" class = " text-green-700">Home</a>
                </li>
                <ChevronRight size={20} stroke-width={3} class='text-green-700'/>
               <li>
                        <p class = " text-green-700">Categoria</p>
                </li>

                <ChevronRight size={20} stroke-width={3} class='text-green-700'/>
               
                 <li class = "inline-flex items-center">
                    <a href={`/categoria/${post.frontmatter.categoria}`} class="text-green-700 capitalize">
                        {post.frontmatter.categoria}
                    </a>
                </li>
                <ChevronRight size={20} stroke-width={3} class='text-green-700'/>
                <li>
                        <p class="text-green-700">{post.frontmatter.title}</p>
                </li>
            </ol>
        </nav>
     <main class="flex flex-col gap-15 mt-15 p-10">
     <article class="mb-4 md:mb-0 w-full max-w-[800px] mx-auto relative" style="height: 24em;">
        <div class="absolute left-0 bottom-0 w-full h-full z-10"
          style="background-image: linear-gradient(180deg,transparent,rgba(0,0,0,.7));">
        
        </div>
        <img 
        src={post.frontmatter.image} 
        alt={post.frontmatter.title} 
        decoding="async"
        fetchpriority="high"
        class="absolute left-0 top-0 w-full h-full z-0 object-cover object-top" />
    
        <div class="p-4 absolute bottom-0 left-0 z-20">
          <a href=`/categoria/${post.frontmatter.categoria}`
            class="px-4 py-1 bg-black text-green-700 inline-flex items-center justify-center mb-2">#{post.frontmatter.categoria}</a>
          <h1 class="font-fluid text-2xl font-semibold text-gray-100">
            {post.frontmatter.title}
          </h1>
              <p class="font-semibold text-gray-300 text-justify">{post.frontmatter.description}</p>
            <time datetime={post.frontmatter.date}>
  Publicado em {post.frontmatter.date}
</time>
            </div>
     </article>
     <div class="mb-4 md:mb-0 w-full max-w-[800px] mx-auto relative text-justify">
     <Content />
     </div>
     </main>
    
</Layout>
