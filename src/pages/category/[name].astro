---
import Layout from '../../layouts/Layout.astro';
import PostsList from '../../components/posts-list.astro';
import Navbar from '../../components/navbar.astro';
export function getStaticPaths() {
  return [
    { params: { name: "fones" }},
    { params: { name: "notebooks" }},
    { params: { name: "smartphones" }},
  ];
}
const posts = import.meta.glob('../../content/posts/*.md', {
    eager: true
});

const { name } = Astro.params;
const postsCategory = Object.entries(posts)
  .filter(([_, post]) => post.frontmatter.category === name)
  .map(([_, post]) => post);

---
<Layout title=`Mapa de Ofertas | ${name}` description=`Todas as ofertas de ${name}`>
<PostsList posts={postsCategory} />
    
</Layout>
