---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';


export function getStaticPaths() {
const posts = import.meta.glob('../../content/posts/*.md', {
    eager: true
});

    return Object.entries(posts).map(([path, post]) => {
        const slug = path.split('/').pop().replace('.md', '');

        return {
            params: { slug },
            props: { post }
        };
    });
}

const { post } = Astro.props;
const { slug }= Astro.params;

if (!post) {
    return new Response(null, {
        status: 404
    });
}

const { Content } = post;
---

<Layout title=`Mapa de Ofertas | ${slug}``> 
    <Header />
    <main class="post-page">
        <article class="path">
  <a href="/">Inicio&nbsp/&nbsp</a>
  <a href={`/category/${post.frontmatter.category}`}>{post.frontmatter.category}&nbsp/&nbsp</a>
  <a>&nbsp{slug}</a>
        </article>
    <Content />
</main>
</Layout>