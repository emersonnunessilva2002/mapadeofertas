---
import Layout from '../../layouts/Layout.astro';
import PostsList from '../../components/posts-list.astro';
import { ChevronRight } from '@lucide/astro';



export function getStaticPaths() {
  return [
    { params: { name: "fones" }},
    { params: { name: "notebooks" }},
    { params: { name: "smartphones" }},
  ];
}
const posts = import.meta.glob('../../content/posts/*.md', {
    eager: true
});

const { name } = Astro.params;
const postsCategory = Object.entries(posts)
  .filter(([_, post]) => post.frontmatter.categoria === name)
  .map(([_, post]) => post);

---
<Layout title=`Promoções de ${name}` description=` As melhores promoções de ${name}`>
  <nav class="w-[100vw] m-auto">
            <ol class="flex items-center justify-center gap-2 p-8 text-[1rem]">
              <li>
                        <a href="/" class = " text-green-700">Home</a>
                </li>
                <ChevronRight size={20} stroke-width={3} class='text-green-700'/>
               <li>
                        <p class = " text-green-700">Categoria</p>
                </li>

                <ChevronRight size={20} stroke-width={3} class='text-green-700'/>
               
                 <li class = "inline-flex items-center">
                    <p class = " text-green-700 capitalize">
                        {name}
                    </p>
                </li>
            </ol>
        </nav>
<PostsList posts={postsCategory} />   
</Layout>
