---
const { post } = Astro.props;
---

        
      
  <div class=" h-[12rem] w-full flex flex-row justify-start items-start rounded-xl border-b-1 border-gray-300  relative overflow-hidden desktop:w-[24rem] mx-auto" >

<div class="absolute left-0 bottom-0 w-full h-full z-10"
          style="background-image: linear-gradient(360deg,transparent,rgba(0,0,0,1));">
        
        </div>
        <img
        src={post.frontmatter.image}
        alt={post.frontmatter.title}
        decoding="async"
        class="absolute left-0 top-0 w-full h-full z-0 object-contain object-top p-1"
        fetchpriority="high"
      />

    <div
      class="flex flex-col justify-start items-start p-4 h-full w-full text-[0.8rem] mobile2:text-[1rem] mobile3:text-[1.3rem] mobile4:text-[0.8rem] desktop:text-[1.1rem] z-50"
    >
      <h2 class="text-ellipsis  text-white font-bold">
        <a
        href={`/posts/${post.frontmatter.slug}`}>
        {post.frontmatter.title}<strong class="text-green-700">.</strong>
        </a>
      </h2>
      
    </div>
   
  </div>
