---
const { post } = Astro.props;
---

<div class="lg:flex border-b-1 border-gray-300">
      
        <div class="relative h-[75%] w-full overflow-hidden">
          <img
            src={post.frontmatter.image}
            alt={post.frontmatter.title}
            width={1000}
            height={800}
            class="h-full w-full object-cover"
            fetchpriority="high"
          />
        </div>

        <div class="flex flex-col justify-center items-start p-4 rounded h-[25%]">
        
        <span class="text-green-700 text-lg"
      >#{post.frontmatter.category}</span>
        <h2 class="md:mt-0 text-gray-800 font-semibold text-3xl mb-2">
      <a href={`/posts/${post.frontmatter.slug}`} data-astro-prefetch="tap">
        {post.frontmatter.title}
      </a>
    </h2>
        </div>
      
    </div>
  
