---
const pathname = Astro.url.pathname.replace(/\/$/, '');
---


<nav class="flex flex-col gap-2 text-center content-center desktop:flex-row desktop:text-left desktop:justify-between py-6 px-8 bg-white shadow desktop:items-center w-full">
  <div class="flex flex-col gap-1 mb-2 desktop:mb-0 inner">

    <h1 class="text-3xl no-underline text-grey-darkest hover:text-blue-dark font-sans font-bold"><a href="/">Mapa de Ofertas</a></h1><br>
    <span class="text-xl text-grey-dark">As melhores ofertas aqui</span>

  </div>

  <div class="flex flex-wrap justify-center gap-x-4 gap-y-2">
    <a href="/posts" 
    class:list={{"text-green-700": pathname === "/posts"
    }} 
    class="text-xl no-underline text-black hover:text-blue-dark ml-2 px-1">Ofertas</a>
    <a href="/category/fones" 
    class:list={{"text-green-700": pathname === "/category/fones"
    }} 
    class="text-xl no-underline text-black hover:text-blue-dark ml-2 px-1">Fones</a>

    <a href="/category/notebooks" 
    class:list={{
        "text-green-700": pathname === "/category/notebooks"
    }}
    class="text-xl no-underline text-grey-darker hover:text-blue-dark ml-2 px-1">Notebooks</a> 

    <a href="/category/smartphones" 
    class:list={{
        "text-green-700": pathname === "/category/smartphones"
    }}
    class="text-xl no-underline text-grey-darker hover:text-blue-dark ml-2 px-1">Smartphones</a>

  </div>
</nav>