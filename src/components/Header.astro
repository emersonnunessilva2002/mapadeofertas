---
const pathname = Astro.url.pathname.replace(/\/$/, '');
---

<header class="header">
    <h1><a href="/" class="logo">Mapa de Ofertas</a></h1>
    <nav class="tags">
      <a href="/category/fones" class:list={{
                    active: pathname === "/category/fones"
                }}>Fones</a>
      <a href="/category/notebooks" class:list={{
                    active: pathname === "/category/notebooks"
                }}>Notebooks</a>
      <a href="/category/smartphones" class:list={{
                    active: pathname === "/category/smartphones"
                }}>Smartphones</a>
    </nav>
</header>
