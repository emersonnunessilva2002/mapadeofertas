---
import { Image } from 'astro:assets'
const { post } = Astro.props;
const { Content } = post;
console.log(Content);
---

<div class="Card">
<div class="Card-content">
    <h2><a href={`/post/${post.frontmatter.slug}`}>{post.frontmatter.title}</a></h2>
    <p>{post.frontmatter.description}</p>
</div>
{post.frontmatter.image && (
<Image src={post.frontmatter.image} alt={post.frontmatter.title} inferSize={true} format="webp" priority loading="eager" quality={'low'}/>
)}
</div>
