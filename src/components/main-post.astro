---

const { post } = Astro.props;

---



<section
  class="
    w-full
    flex
    flex-col
    items-center
    justify-center
    bg-white
    m-auto
    mt-10
    mb-10
    p-8
    border-1
    border-gray-300
    desktop:max-w-[500px]
    desktop:min-h-[600px]
  "
>
  <img
    src={post.frontmatter.image}
    class="w-full max-w-[500px] h-auto object-contain"
    alt=""
  />

  <div class="flex flex-col gap-2">
    <h1>
      <a
        href={`/posts/${post.frontmatter.slug}`}
        class="text-4xl font-medium text-gray-900 font-fluid"
      >
        {post.frontmatter.title}
      </a>
    </h1>

    <p class="text-gray-500 font-fluid">
      {post.frontmatter.description}
    </p>
  </div>
</section>