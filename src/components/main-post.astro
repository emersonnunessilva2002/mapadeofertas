---

const { post } = Astro.props;

---



<section
  class="
    w-full
    flex
    flex-col
    items-center
    justify-center
    bg-white
    m-auto
    mt-10
    mb-10
    border-1
    border-gray-300
    desktop:max-w-[800px]
    desktop:flex-row
    desktop:h-[50vh]
    "
>
  <img
    src={post.frontmatter.image}
    width={500}
    class=" h-[50vh] object-contain p-2"
    alt=""
  />

  <div class=" w-full h-full flex flex-col justify-start items-start gap-2 p-12 text-left">
    <span class="text-green-700"
      >#{post.frontmatter.categoria}</span>
    <h1>
      <a
        href={`/posts/${post.frontmatter.slug}`}
        class="text-3xl font-bold text-gray-900"
      >
        {post.frontmatter.title}
      </a>
    </h1>

    <p class="text-gray-500 text-justify">
      {post.frontmatter.description}
    </p>
  </div>
</section>