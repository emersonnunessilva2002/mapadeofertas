---
import Logo from "../assets/logotipo.png";
import { Menu } from "@lucide/astro";

const pathname = Astro.url.pathname.replace(/\/$/, "");
---

<nav class="relative w-full p-4 flex flex-col justify-around items-center border-gray-300 desktop:flex-row border-gray-300 border-b-1">

  <!-- Logo -->
  <div class="flex flex-col justify-center items-center">
    <a href="/" class = " text-green-700">
    <img
      src={Logo.src}
      class="pointer-events-none h-36 w-auto object-contain desktop:h-24"
    />
</a>
    <span class="text-[0.8rem]">As melhores promoções aqui</span>
  </div>


 
  <input
    type="checkbox"
    id="menu-toggle"
    class="peer absolute opacity-0 pointer-events-none"
  />

     <label
    for="menu-toggle"
    class="absolute right-4 top-8 cursor-pointer desktop:hidden"
  >
    <Menu size={40} />
  </label>

  <ul
    class="
      bg-white
      z-50
      hidden
      peer-checked:flex
      flex-col
      justify-center
      items-center
      gap-4
      w-[100vw]
      mt-4
      text-[1rem]
      p-4
      border-gray-300
      desktop:mt-0
      desktop:w-auto
      desktop:flex
      desktop:flex-row
      desktop:gap-6
      desktop:-translate-y-0
    "
  >
    <li >
      <a 
      href="/"
      class="block px-2 py-1 font-semibold"
       class:list={{ "text-green-700": pathname === ""}}
      >    
        Home
      </a>
    </li>

    <li>
      <a 
      href="/posts" 
      class="block px-2 py-1 font-semibold"
      class:list={{ "text-green-700": pathname === "/posts"}}
      >  
        Promoções
      </a>
    </li>

    <li>
      <a 
      href="/categoria/smartphones" 
      class="block px-2 py-1 font-semibold"
      class:list={{ "text-green-700": pathname === "/categoria/smartphones"}}
      >
        Smartphones
      </a>
    </li>
    <li>
      <a 
      href="/categoria/fones" 
      class="block px-2 py-1 font-semibold"
      class:list={{ "text-green-700": pathname === "/categoria/fones"}}
      >
        Fones
      </a>
    </li>
    <li>
      <a 
      href="/categoria/notebooks" 
      class="block px-2 py-1 font-semibold"
      class:list={{ "text-green-700": pathname === "/categoria/notebooks"}}
      >
        Notebooks
      </a>
    </li>
  </ul>

  

</nav>