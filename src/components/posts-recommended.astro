---
import CardPost from "./card-post.astro";

const { posts } = Astro.props;


---

<section class="bg-white border-t-1 border-gray-300 px-4">
    <div class="container px-6 py-10 mx-auto">
<article class="grid grid-cols-1 gap-8 mt-8 md:mt-16 md:grid-cols-2">
    {posts.map((post) => (
       <CardPost post={post} />
    ))}
</article>
</div>
</section>
